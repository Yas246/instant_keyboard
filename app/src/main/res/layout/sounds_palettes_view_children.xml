<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-only -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Barre de requête « dans le clavier » : simple TextView non focusable — la fenêtre de
         l'IME n'a pas le focus système, le texte arrive par le pipeline de touches
         (KeyboardActionListenerImpl), jamais commité dans le champ de l'application.
         Ellipsize start : la fin de la requête (la plus récente) reste visible. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/sounds_query_view"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:ellipsize="start"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:textColorHint="#B3FFFFFF"
            android:text="@string/search_sounds_hint" />

        <TextView
            android:id="@+id/sounds_clear_search"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="6dp"
            android:text="✕"
            android:textSize="16sp"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/sounds_back_to_keyboard"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:contentDescription="@string/sounds_back_to_keyboard"
            android:text="⌨"
            style="?attr/suggestionWordStyle" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView android:id="@+id/sounds_tab_trending" style="@style/SoundsTab"
            android:text="@string/sounds_tab_trending" />
        <TextView android:id="@+id/sounds_tab_favorites" style="@style/SoundsTab"
            android:text="@string/sounds_tab_favorites" />
        <TextView android:id="@+id/sounds_tab_recents" style="@style/SoundsTab"
            android:text="@string/sounds_tab_recents" />
    </LinearLayout>

    <TextView
        android:id="@+id/sounds_status_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="24dp"
        android:text="@string/sounds_empty"
        android:visibility="visible" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/sounds_recycler"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:visibility="gone" />
</LinearLayout>
